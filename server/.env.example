# DefiNet API server
PORT=4000

# JWT secrets — change in production!
ACCESS_TOKEN_SECRET=dev-access-secret-change-me
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me

# MongoDB Atlas connection string (optional).
# When empty, a local MongoDB starts automatically with a persistent data
# directory (server/data/mongo) — great for local dev / the simulator.
MONGODB_URI=

# Origin of the Next.js site (CORS + refresh cookie)
CLIENT_ORIGIN=http://localhost:3000
